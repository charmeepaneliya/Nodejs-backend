<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>Home page</title>
</head>
<body>
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card p-5 shadow" style="width: 40rem;">
            <h1 class="text-center mb-3">Home Page</h1>

    <ul class="list-group p-4">
        <% studentList.forEach((s) => { %>
            <li class="list-group-item text-center ">
                <span class="me-5"><%= s.name %></span>
                    <a href="/edit/<%=s.id%>" class="btn btn-warning btn-sm me-2">Edit</a>
                    <a href="/delete/<%=s.id%>" class="btn btn-danger btn-sm me-2">Delete</a>
                <div>

                </div>
            </li>
        <% }) %>
    </ul>

        <a class="text-center btn btn-primary mb-3" href="/add">Add</a>
        
        </div>
        
    </div>
    

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</body>
</html>