
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Edit user</title>
</head>
<body>
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card p-3 shadow" style="width: 30rem; border-radius: 30px;">
            <h1 class="text-center mt-5" style="color: #f28e1c;">Edit user</h1>

    <form class="text-center mt-4" action="/edit/<%=student.id %>" method="post">
        <input class="p-2 rounded border-1 w-50" type="text" name="name" value="<%= student.name %>" required>
        <br/><br/>
        <button class="btn btn-success" type="submit">Update</button>
        </div>
        
    </form> 
    </div>
    
    
</body>
</html>